								<xs:documentation xml:lang="cs">01000 Datum, ke kterému se vztahují data Target Market v rámci EMT</xs:documentation>
								<xs:documentation xml:lang="hu">01000 Az a dátum, amelyre az EMT-n belüli célpiaci (Target Market) adatok vonatkoznak</xs:documentation>
								<xs:documentation xml:lang="da">01000 Dato, som Target Market-dataene i EMT'en refererer til</xs:documentation>
								<xs:documentation xml:lang="pl">01000 Data, do której odnoszą się dane Target Market w EMT</xs:documentation>
								<xs:documentation xml:lang="sv">01000 Datum som Target Market-uppgifterna inom EMT avser</xs:documentation>
							</xs:annotation>
