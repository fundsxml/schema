			<xs:element name="HoldingAndRedemption" type="PRIIPsKID_HoldingAndRedemptionType">
				<xs:annotation>
					<xs:documentation xml:lang="en">Section "How long should I hold it and can I take money out early?"</xs:documentation>
					<xs:documentation xml:lang="de">Abschnitt "Wie lange sollte ich die Anlage halten, und kann ich vorzeitig Geld entnehmen?"</xs:documentation>
					<xs:documentation xml:lang="fr">Section « Combien de temps dois-je le conserver, et puis-je retirer de l'argent de façon anticipée ? »</xs:documentation>
					<xs:documentation xml:lang="nl">Rubriek "Hoe lang moet ik het houden en kan ik er eerder geld uit halen?"</xs:documentation>
					<xs:documentation xml:lang="es">Sección «¿Cuánto tiempo debo mantener la inversión, y puedo retirar el dinero de manera anticipada?»</xs:documentation>
					<xs:documentation xml:lang="it">Sezione "Per quanto tempo devo detenerlo? Posso ritirare il capitale prematuramente?"</xs:documentation>
					<xs:documentation xml:lang="hu">„Mennyi ideig kell tartanom, és idő előtt kivehetem-e a pénzt?” szakasz</xs:documentation>
					<xs:documentation xml:lang="cs">Oddíl „Jak dlouho bych měl investici držet a mohu si peníze vybrat předčasně?“</xs:documentation>
					<xs:documentation xml:lang="da">Afsnittet "Hvor længe skal jeg beholde det, og kan jeg hæve penge før tid?"</xs:documentation>
					<xs:documentation xml:lang="pl">Sekcja „Jak długo powinienem posiadać produkt i czy mogę wcześniej podjąć pieniądze?”</xs:documentation>
					<xs:documentation xml:lang="sv">Avsnittet "Hur länge bör jag behålla investeringen och kan jag ta ut pengar i förtid?"</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Complaints" type="PRIIPsKID_ComplaintsType">
				<xs:annotation>
					<xs:documentation xml:lang="en">Section "How can I complain?"</xs:documentation>
					<xs:documentation xml:lang="de">Abschnitt "Wie kann ich mich beschweren?"</xs:documentation>
					<xs:documentation xml:lang="fr">Section « Comment puis-je formuler une réclamation ? »</xs:documentation>
					<xs:documentation xml:lang="nl">Rubriek "Hoe kan ik een klacht indienen?"</xs:documentation>
					<xs:documentation xml:lang="es">Sección «¿Cómo puedo reclamar?»</xs:documentation>
					<xs:documentation xml:lang="it">Sezione "Come presentare reclami?"</xs:documentation>
					<xs:documentation xml:lang="hu">„Hogyan tehetek panaszt?” szakasz</xs:documentation>
					<xs:documentation xml:lang="cs">Oddíl „Jakým způsobem mohu podat stížnost?“</xs:documentation>
					<xs:documentation xml:lang="da">Afsnittet "Hvordan kan jeg klage?"</xs:documentation>
					<xs:documentation xml:lang="pl">Sekcja „Jak mogę złożyć skargę?”</xs:documentation>
					<xs:documentation xml:lang="sv">Avsnittet "Hur kan jag klaga?"</xs:documentation>
				</xs:annotation>
