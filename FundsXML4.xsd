											<xs:documentation xml:lang="en">Usage type data breakdown (office, retail, residential, etc.)</xs:documentation>
											<xs:documentation xml:lang="de">Nutzungsartdaten-Aufschlüsselung (Büro, Handel, Wohnen usw.)</xs:documentation>
											<xs:documentation xml:lang="fr">Ventilation des données par type d'utilisation (bureau, commerce, résidentiel, etc.)</xs:documentation>
											<xs:documentation xml:lang="nl">Gegevens per gebruikstype (kantoor, winkel, wonen, enz.)</xs:documentation>
