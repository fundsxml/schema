					<xs:documentation xml:lang="en">Section "What happens if the PRIIP manufacturer is unable to pay out?"</xs:documentation>
					<xs:documentation xml:lang="de">Abschnitt "Was geschieht, wenn der PRIIP-Hersteller nicht in der Lage ist, die Auszahlung vorzunehmen?"</xs:documentation>
					<xs:documentation xml:lang="fr">Section « Que se passe-t-il si l'initiateur du PRIIP n'est pas en mesure d'effectuer les versements ? »</xs:documentation>
					<xs:documentation xml:lang="nl">Rubriek "Wat gebeurt er als de PRIIP-ontwikkelaar niet kan uitbetalen?"</xs:documentation>
					<xs:documentation xml:lang="es">Sección «¿Qué pasa si el productor del PRIIP no puede pagar?»</xs:documentation>
					<xs:documentation xml:lang="it">Sezione "Cosa accade se l'ideatore del PRIIP non è in grado di corrispondere quanto dovuto?"</xs:documentation>
					<xs:documentation xml:lang="hu">„Mi történik, ha a PRIIP-előállító nem tud fizetni?” szakasz</xs:documentation>
					<xs:documentation xml:lang="cs">Oddíl „Co se stane, když tvůrce PRIIP není schopen uskutečnit výplatu?“</xs:documentation>
					<xs:documentation xml:lang="da">Afsnittet "Hvad sker der, hvis PRIIP-producenten ikke er i stand til at udbetale?"</xs:documentation>
					<xs:documentation xml:lang="pl">Sekcja „Co się stanie, jeśli twórca PRIIP nie ma możliwości dokonania wypłaty?”</xs:documentation>
					<xs:documentation xml:lang="sv">Avsnittet "Vad händer om Priip-tillverkaren inte kan göra några utbetalningar?"</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Costs" type="PRIIPsKID_CostsType">
				<xs:annotation>
					<xs:documentation xml:lang="en">Section "What are the costs?"</xs:documentation>
					<xs:documentation xml:lang="de">Abschnitt "Welche Kosten entstehen?"</xs:documentation>
					<xs:documentation xml:lang="fr">Section « Que va me coûter cet investissement ? »</xs:documentation>
					<xs:documentation xml:lang="nl">Rubriek "Wat zijn de kosten?"</xs:documentation>
					<xs:documentation xml:lang="es">Sección «¿Cuáles son los costes?»</xs:documentation>
					<xs:documentation xml:lang="it">Sezione "Quali sono i costi?"</xs:documentation>
					<xs:documentation xml:lang="hu">„Milyen költségek merülnek fel?” szakasz</xs:documentation>
					<xs:documentation xml:lang="cs">Oddíl „Jaké náklady mi vzniknou?“</xs:documentation>
					<xs:documentation xml:lang="da">Afsnittet "Hvad er omkostningerne?"</xs:documentation>
					<xs:documentation xml:lang="pl">Sekcja „Jakie są koszty?”</xs:documentation>
					<xs:documentation xml:lang="sv">Avsnittet "Vilka är kostnaderna?"</xs:documentation>
				</xs:annotation>
