									<xs:documentation xml:lang="hu">Az időszak kezdő dátuma</xs:documentation>
									<xs:documentation xml:lang="cs">Datum začátku období</xs:documentation>
									<xs:documentation xml:lang="da">Periodens startdato</xs:documentation>
									<xs:documentation xml:lang="pl">Data początkowa okresu</xs:documentation>
									<xs:documentation xml:lang="sv">Periodens startdatum</xs:documentation>
								</xs:annotation>
