											<xs:documentation xml:lang="cs">01030: Typ investora Eligible Counterparty (způsobilá protistrana)</xs:documentation>
											<xs:documentation xml:lang="hu">01030: Befektető Típus Elfogadható partner</xs:documentation>
											<xs:documentation xml:lang="da">01030: Investor Type Eligible Counterparty</xs:documentation>
											<xs:documentation xml:lang="pl">01030: Investor Type Eligible Counterparty</xs:documentation>
