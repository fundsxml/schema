					<xs:documentation xml:lang="fr">Mic de Stockmarket de actif</xs:documentation>
					<xs:documentation xml:lang="nl">Mic van Stockmarket van actief</xs:documentation>
					<xs:documentation xml:lang="es">Mic el Stockmarket el activo</xs:documentation>
					<xs:documentation xml:lang="it">Mic del mercato azionario dell'asset</xs:documentation>
					<xs:documentation xml:lang="cs">MIC burzy daného aktiva</xs:documentation>
					<xs:documentation xml:lang="hu">Az eszköz tőzsdéjének MIC-kódja</xs:documentation>
					<xs:documentation xml:lang="da">MIC for aktivets aktiemarked</xs:documentation>
					<xs:documentation xml:lang="pl">MIC rynku giełdowego aktywa</xs:documentation>
					<xs:documentation xml:lang="sv">MIC för tillgångens börs</xs:documentation>
					<xs:appinfo>
