			<xs:documentation xml:lang="de">Dreistelliger ISO-Währungscode (ISO 4217)</xs:documentation>
			<xs:documentation xml:lang="fr">Code de devise ISO à trois lettres (ISO 4217)</xs:documentation>
			<xs:documentation xml:lang="nl">Drieletterige ISO-valutacode (ISO 4217)</xs:documentation>
			<xs:documentation xml:lang="es">Código ISO de divisa de tres letras (ISO 4217)</xs:documentation>
			<xs:documentation xml:lang="it">Codice valuta ISO di tre lettere (ISO 4217)</xs:documentation>
			<xs:documentation xml:lang="cs">Třípísmenný ISO kód měny (ISO 4217)</xs:documentation>
			<xs:documentation xml:lang="hu">Háromjegyű ISO-pénznemkód (ISO 4217)</xs:documentation>
			<xs:documentation xml:lang="da">Trebogstavs ISO-valutakode (ISO 4217)</xs:documentation>
			<xs:documentation xml:lang="pl">Trzyliterowy kod waluty ISO (ISO 4217)</xs:documentation>
			<xs:documentation xml:lang="sv">Treställig ISO-valutakod (ISO 4217)</xs:documentation>
		</xs:annotation>
