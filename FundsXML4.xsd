					<xs:documentation xml:lang="pl">Wszelkiego rodzaju dane podziału (w tym ekspozycja walutowa)</xs:documentation>
					<xs:documentation xml:lang="sv">Alla slags uppdelningsdata (inklusive valutaexponering)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RiskCodes" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="en">List of risk codes (risk indicators, key risk figures)</xs:documentation>
					<xs:documentation xml:lang="de">Risiko-Kennzahlen</xs:documentation>
					<xs:documentation xml:lang="fr">Liste des codes de risque (indicateurs de risque, chiffres clés de risque)</xs:documentation>
					<xs:documentation xml:lang="nl">Lijst van risicocodes (risico-indicatoren, belangrijke risicokengetallen)</xs:documentation>
					<xs:documentation xml:lang="es">Lista de códigos de riesgo (indicadores de riesgo, cifras clave de riesgo)</xs:documentation>
					<xs:documentation xml:lang="it">Elenco dei codici di rischio (indicatori di rischio, cifre chiave di rischio)</xs:documentation>
					<xs:documentation xml:lang="cs">Seznam risk codes (risk indicators, key risk figures)</xs:documentation>
					<xs:documentation xml:lang="hu">Kockázati kódok listája (kockázati indikátorok, fő kockázati mutatószámok)</xs:documentation>
					<xs:documentation xml:lang="da">Liste over risikokoder (risikoindikatorer, centrale risikotal)</xs:documentation>
					<xs:documentation xml:lang="pl">Lista kodów ryzyka (wskaźniki ryzyka, kluczowe wartości ryzyka)</xs:documentation>
					<xs:documentation xml:lang="sv">Lista över riskkoder (riskindikatorer, viktiga riskmått)</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="RiskCode" type="RiskCodeType" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation xml:lang="en">Risk code value</xs:documentation>
								<xs:documentation xml:lang="de">Wert des Risicocodes</xs:documentation>
								<xs:documentation xml:lang="fr">Valeur du code de risque</xs:documentation>
								<xs:documentation xml:lang="nl">Waarde van de risicocode</xs:documentation>
								<xs:documentation xml:lang="es">Valor del código de riesgo</xs:documentation>
								<xs:documentation xml:lang="it">Valore del codice di rischio</xs:documentation>
								<xs:documentation xml:lang="cs">Hodnota rizikového kódu</xs:documentation>
								<xs:documentation xml:lang="hu">Kockázati kód értéke</xs:documentation>
								<xs:documentation xml:lang="da">Risikokodeværdi</xs:documentation>
								<xs:documentation xml:lang="pl">Wartość kodu ryzyka</xs:documentation>
								<xs:documentation xml:lang="sv">Värde för riskkod</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PositionsDecomposedType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Look-through decomposed positions where fund-of-fund holdings are replaced by the underlying subfund positions</xs:documentation>
			<xs:documentation xml:lang="de">Look-Through-aufgelöste Positions, bei denen Fund-of-Fund-Holdings durch die unterliegenden Subfund Positions ersetzt werden</xs:documentation>
			<xs:documentation xml:lang="fr">Positions décomposées look-through où les holdings fund-of-fund sont remplacées par les positions subfund sous-jacentes</xs:documentation>
			<xs:documentation xml:lang="nl">Look-through gedecomposeerde positions waarbij fund-of-fund holdings worden vervangen door de onderliggende subfund positions</xs:documentation>
			<xs:documentation xml:lang="es">Posiciones descompuestas look-through donde los holdings de fund-of-fund se reemplazan por las posiciones del subfondo subyacente</xs:documentation>
