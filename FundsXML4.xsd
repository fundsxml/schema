					<xs:documentation xml:lang="es">Costes y cargos ex ante</xs:documentation>
					<xs:documentation xml:lang="it">Costi e oneri ex ante</xs:documentation>
					<xs:documentation xml:lang="cs">Náklady a poplatky ex ante</xs:documentation>
					<xs:documentation xml:lang="hu">Költségek és díjak ex ante</xs:documentation>
					<xs:documentation xml:lang="da">Costs and Charges ex ante</xs:documentation>
					<xs:documentation xml:lang="pl">Koszty i opłaty ex ante</xs:documentation>
